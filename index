      padding: 8px;
      border-radius: 7px;
      cursor: pointer;
      font-size: 11px;
      color: var(--text)
    }

    .assignee-option:hover {
      background: #f7f6ff
    }

    .assignee-option input {
      accent-color: var(--primary)
    }

    .assignee-empty {
      padding: 8px;
      color: var(--muted);
      font-size: 11px
    }

    .assignee-help {
      display: block;
      margin-top: 5px;
      font-size: 10px;
      color: var(--muted)
    }

    @media(max-width:760px) {
      .card-detail-modal {
        grid-template-columns: 1fr;
        padding: 20px;
        gap: 8px
      }

      .card-detail-sidebar {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        padding-top: 0
      }

      .card-detail-sideheading {
        grid-column: 1/-1
      }

      .card-detail-heading h2 {
        font-size: 17px
      }
    }
  </style>
</head>

<body>
  <div class="app">
    <aside class="sidebar" id="sidebar">
      <div class="brand">
        <div class="brandmark">F</div> ForgePM <span style="font-size:10px;color:#929db8;font-weight:600">BETA</span>
      </div>
      <button class="project-switch"
        onclick="toast('Project switcher prototype')"><span><small>WORKSPACE</small><strong>Starlight
            RPG</strong></span><span>⌄</span></button>
      <div class="navgroup">
        <div class="navtitle">Workspace</div>
        <button class="navitem active" data-page="overview"><span class="navicon">◫</span> Overview</button>
        <button class="navitem" data-page="structure"><span class="navicon">⌘</span> Initiative & WBS</button>
        <button class="navitem" data-page="backlog"><span class="navicon">☷</span> Product Backlog <span
            class="tag gray" style="margin-left:auto">12</span></button>
        <button class="navitem" data-page="charts"><span class="navicon">▥</span> Timeline & Charts</button>
        <button class="navitem" data-page="sprint"><span class="navicon">◷</span> Sprint Planning</button>
        <button class="navitem" data-page="calendar"><span class="navicon">▦</span> Work Calendar & Sprints</button>
        <button class="navitem" data-page="availability"><span class="navicon">◷</span> Team Availability</button>
      </div>
      <div class="navgroup">
        <div class="navtitle">Execution</div>
        <button class="navitem" data-page="confirmation"><span class="navicon">▦</span> Sprint Confirmation</button>
        <button class="navitem" data-page="board" id="boardNav" style="display:none"><span class="navicon">▤</span>
          Sprint Board</button>
        <button class="navitem" data-page="weekly-monitor" id="weeklyMonitorNav" style="display:none"><span
            class="navicon">▦</span> Weekly Target Monitoring</button>
        <button class="navitem" data-page="changelog"><span class="navicon">↻</span> Change Log</button>
      </div>
      <div class="sidebar-bottom">Game Production Workspace<br><span style="color:#697694">Prototype · sample data
          only</span></div>
    </aside>
    <main class="main">
      <header class="topbar">
        <div style="display:flex;align-items:center;gap:12px"><button class="btn mobilemenu" id="mobilemenu">☰</button>
          <div class="crumb">Starlight RPG <span style="padding:0 7px;color:#c1c6d4">/</span> <strong
              id="crumbname">Overview</strong></div>
        </div>
        <div class="top-actions"><button class="btn small" onclick="toast('Notifikasi: tidak ada pembaruan baru')">♧
            <span class="muted">Notifications</span></button>
          <div class="avatar" title="Ren · Project Manager">R</div>
        </div>
      </header>
      <div class="content">
        <!-- OVERVIEW -->
        <section class="section active" id="page-overview">
          <div class="pagehead">
            <div>
              <div class="eyebrow">PROJECT WORKSPACE</div>
              <h1>Good morning, Ren.</h1>
              <div class="subtitle">Pantau scope, kapasitas tim, dan target build dari satu tempat.</div>
            </div>
            <div class="actions"><button class="btn" onclick="navigate('changelog')">＋ Record change</button><button
                class="btn primary" onclick="navigate('sprint')">Plan a sprint →</button></div>
          </div>
          <div class="grid stats">
            <div class="stat">
              <div class="statlabel">Overall progress <span>◔</span></div>
              <div class="statvalue">42%</div>
              <div class="bar">
                <div class="fill" style="width:42%"></div>
              </div>
              <div class="statfoot" style="margin-top:8px"><strong>+6%</strong> dari minggu lalu</div>
            </div>
            <div class="stat">
              <div class="statlabel">Open tasks <span>☷</span></div>
              <div class="statvalue" id="statTasks">12</div>
              <div class="statfoot">Di Product Backlog</div>
            </div>
            <div class="stat">
              <div class="statlabel">Team capacity <span>♙</span></div>
              <div class="statvalue">84%</div>
              <div class="statfoot"><strong>Healthy</strong> · 16% buffer tersisa</div>
            </div>
            <div class="stat">
              <div class="statlabel">Next build <span>⚑</span></div>
              <div class="statvalue">0.4</div>
              <div class="statfoot">Target · 14 Nov 2026</div>
            </div>
          </div>
          <div class="panel overview-sprint-analytics" style="margin:16px 0">
            <div class="panelhead">
              <div><h2>Sprint Analytics</h2><p>Burndown, burnup, dan weekly target berdasarkan sprint yang sudah dijalankan.</p></div>
              <div class="actions"><label class="muted" for="overviewSprintSelect">Sprint</label><select class="select" id="overviewSprintSelect" onchange="renderOverviewSprintAnalytics()"></select></div>
            </div>
            <div id="overviewSprintAnalyticsBody"><div class="empty">Belum ada sprint yang dijalankan. Mulai sprint dari Sprint Board untuk melihat analytics.</div></div>
          </div>
          <div class="panel" style="margin:16px 0">
            <div class="panelhead">
              <div>
                <h2>Release category progress</h2>
                <p>Progress dihitung dari item berlabel dan descendant-nya dalam kategori tersebut.</p>
              </div><button class="linkbtn" onclick="navigate('structure')">Manage WBS labels →</button>
            </div>
            <div class="grid stats label-progress-grid" id="dashboardLabelProgress"></div>
          </div>
          <div class="grid two-col">
            <div class="panel" id="dashboardMilestonePanel">
              <div class="panelhead">
                <div>
                  <h2>Milestone Progress</h2>
                  <p>Progress scope berdasarkan milestone yang dipilih.</p>
                </div>
                <select class="select" id="dashboardMilestoneSelect" aria-label="Select milestone" onchange="renderDashboardMilestoneProgress()">
                  <option value="Prototype">Prototype</option>
                  <option value="Alpha" selected>Alpha</option>
                  <option value="Demo">Demo</option>
                  <option value="Full">Full</option>
                </select>
              </div>
              <div id="dashboardMilestoneProgressBody"><div class="empty">Pilih milestone untuk melihat work items.</div></div>
            </div>
            
          </div>
          
          <div class="panel" style="margin-top:16px">
            <div class="panelhead">
              <div>
                <h2>Project change transparency</h2>
                <p>Perubahan penting yang perlu diketahui semua anggota tim.</p>
              </div><button class="linkbtn" onclick="navigate('changelog')">Open Change Log →</button>
            </div>
            <div id="dashboardAuditTrail" class="timeline"></div>
          </div>
        </section>

        <!-- STRUCTURE -->
        <section class="section" id="page-structure">
          <div class="pagehead">
            <div>
              <div class="eyebrow">SCOPE MANAGEMENT</div>
              <h1>Initiative & WBS</h1>
              <div class="subtitle">Kelola struktur scope. Task di sini tetap terpisah dari penempatan sprint.</div>
            </div>
            <div class="actions"><button class="btn" onclick="exportWbs()">⇩ Export</button><button class="btn primary"
                onclick="openModal('item')">＋ Add work item</button></div>
          </div>
          <div class="wbs-drag-hint">Drag item ke baris parent yang sesuai untuk memindahkan hierarki. Parent akan
            menghitung ulang rentang tanggal, effort, dan progres dari child items.</div>
          <div class="toolbar">
            <div class="search"><span>⌕</span><input id="wbsSearch"
                placeholder="Cari Initiative, Epic, Feature, task..." oninput="renderWbs()"></div><select class="select"
              id="wbsFilter" onchange="renderWbs()">
              <option value="all">Semua tipe</option>
              <option>Initiative</option>
              <option>Epic</option>
              <option>Feature</option>
              <option>Task</option>
            </select><select class="select" id="wbsLabelFilter" onchange="renderWbs()">
              <option value="all">Semua kategori</option>
              <option>MVP</option>
              <option>Alpha</option>
              <option>Prototype</option>
              <option>Demo</option>
              <option>Full release</option>
            </select><button class="btn" onclick="expandAll(true)">Expand all</button><button class="btn"
              onclick="expandAll(false)">Collapse all</button>
          </div>
          <div class="grid stats label-progress-grid" id="wbsLabelProgress" style="margin:0 0 14px"></div>
          <div class="tablewrap">
            <table class="table">
              <thead>
                <tr>
                  <th style="width:34%">Work item</th>
                  <th>Release labels</th>
                  <th>Owner</th>
                  <th>Workflow status</th>
                  <th>Priority</th>
                  <th>Milestone</th>
                  <th>Progress</th>
                  <th>Effort</th>
                </tr>
              </thead>
              <tbody id="wbsBody"></tbody>
            </table>
          </div>
          <div class="tablefoot"><span>Struktur scope · klik nama untuk edit · klik kanan untuk menu tindakan · drag
              untuk memindahkan</span><span id="wbsCount">12 work items</span></div>
          <div class="panel" style="margin-top:16px">
            <div class="panelhead">
              <div>
                <h2>Work item change transparency</h2>
                <p>Perubahan status, prioritas, scope, dan keputusan dicatat agar semua anggota memahami konteksnya.</p>
              </div>
            </div>
            <div id="wbsAuditTrail" class="timeline"></div>
          </div>
        </section>

        <!-- BACKLOG -->
        <section class="section" id="page-backlog">
          <div class="pagehead">
            <div>
              <div class="eyebrow">PRODUCT DISCOVERY & DELIVERY</div>
              <h1>Product Backlog</h1>
              <div class="subtitle">Task terdaftar di backlog belum otomatis masuk sprint. Periksa readiness sebelum
                dipilih.</div>
            </div>
            <div class="actions"><button class="btn" onclick="openBacklogFilters()">⚙ Filter</button><button
                class="btn primary" onclick="openModal('task')">＋ Create task</button></div>
          </div>
          <div class="toolbar">
            <div class="search"><span>⌕</span><input id="backlogSearch" placeholder="Cari task atau ID..."
                oninput="renderBacklog()"></div><select class="select" id="readyFilter" onchange="renderBacklog()">
              <option value="all">Semua readiness</option>
              <option value="Ready">Ready</option>
              <option value="Not Ready">Not Ready</option>
              <option value="Needs Review">Needs Review</option>
            </select><select class="select" id="priorityFilter" onchange="renderBacklog()">
              <option value="all">Semua priority</option>
              <option>Critical</option>
              <option>High</option>
              <option>Medium</option>
              <option>Low</option>
            </select><select class="select" id="backlogRoleFilter" onchange="renderBacklog()">
              <option value="all">Semua role</option>
              <option value="Engineer">Engineer</option>
              <option value="Designer">Designer</option>
              <option value="Artist">Artist</option>
            </select>
          </div>
          <div class="panel" style="padding:0;overflow:hidden">
            <div
              style="padding:17px 18px;border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:space-between;gap:10px">
              <div><strong>Unscheduled work</strong>
                <div class="muted" style="font-size:11px;margin-top:3px">Pilih task untuk memasukkannya ke draft sprint
                </div>
              </div><span class="tag gray" id="backlogCount">12 tasks</span>
            </div>
            <div id="backlogList" style="padding:14px"></div>
          </div>
        </section>

        <!-- SPRINT -->
        <section class="section" id="page-sprint">
          <div class="pagehead">
            <div>
              <div class="eyebrow">WORKSPACE · PREPARATION</div>
              <h1>Sprint Planning</h1>
              <div class="subtitle">Bangun draft Sprint Backlog: tentukan Sprint Goal, pilih task Ready, dan seimbangkan
                estimasi dengan kapasitas.</div>
            </div>
            <div class="actions"><button class="btn" onclick="resetSprint()">Reset draft</button><button
                class="btn primary" onclick="navigate('confirmation')">Review confirmation →</button></div>
          </div>
          <div class="notice"><span>ⓘ</span>
            <div><strong>Planning workspace</strong>Di sini scope masih berupa draft dan boleh diubah. Belum ada
              baseline resmi, dan task belum dianggap committed sampai melewati review konfirmasi.</div>
          </div>
          <div class="planner-grid">
            <div>
              <div class="panel">
                <div class="panelhead">
                  <div>
                    <h2>01 · Sprint setup</h2>
                    <p>Tentukan target dan periode sprint</p>
                  </div><span class="tag purple">Draft</span>
                </div>
                <div class="formrow">
                  <div class="field">
                    <div class="fieldlabel">Sprint</div><select class="goalinput" id="sprintSelect"
                      onchange="renderSprint();renderPlanningGantt();renderCharts()">
                      <option value="">Generate schedule in Work Calendar</option>
                    </select>
                  </div>
                  <div class="field">
                    <div class="fieldlabel">Team / workstream</div><select class="goalinput" id="teamSelect">
                      <option selected>Cross-discipline</option>
                      <option>Core Gameplay</option>
                      <option>Engineering</option>
                      <option>Content</option>
                      <option>QA</option>
                    </select><small class="muted">Tim yang berkomitmen menyelesaikan sprint ini. “Core Gameplay” hanya
                      contoh workstream, bukan nama tim wajib.</small>
                  </div>
                </div>
                <div class="field">
                  <div class="fieldlabel">Sprint Goal</div><textarea class="goalinput" id="sprintGoal"
                    placeholder="Contoh: pemain dapat menggunakan inventory untuk mengambil dan menyimpan loot.">Pemain dapat mengambil loot dan menyimpannya ke inventory.</textarea>
                </div>
              </div>
              <div class="panel" style="margin-top:14px">
                <div class="panelhead">
                  <div>
                    <h2>02 · Draft Sprint Backlog</h2>
                    <p>Task terpilih dari product backlog</p>
                  </div><span class="tag purple" id="selectedCount">0 tasks</span>
                </div>
                <div class="draftlist" id="draftList"></div>
                <div style="display:flex;justify-content:space-between;gap:10px;align-items:center;flex-wrap:wrap"><span
                    class="muted" style="font-size:11px">Task dapat dilepas kembali ke backlog sebelum
                    konfirmasi.</span><button class="btn small" onclick="navigate('backlog')">＋ Add from
                    backlog</button></div>
              </div>
            </div>
            <div>
              <div class="panel">
                <div class="panelhead">
                  <div>
                    <h2>03 · Capacity planning</h2>
                    <p>Gunakan estimasi untuk menyusun draft yang realistis</p>
                  </div>
                </div>
                <div class="capacity">
                  <div class="capacitytop">
                    <div><small>Planned effort</small>
                      <div class="capacitynum"><span id="plannedEffort">0</span> <small>person-days</small></div>
                    </div>
                    <div style="text-align:right"><small>Team capacity</small>
                      <div class="capacitynum"><span id="teamCapacityValue">40</span> <small>person-days</small></div>
                    </div>
                  </div>
                  <div class="bar" style="margin-top:12px">
                    <div id="capacityFill" class="fill" style="width:0%"></div>
                  </div>
                  <div class="progressrow"><span id="capacityLabel">0% utilized</span><strong id="capacityRemaining">40
                      days remaining</strong></div>
                </div>
                <div class="notice" style="margin:14px 0 0"><span>↗</span>
                  <div>Capacity check membantu perencanaan. Pemeriksaan dependency, readiness, dan keputusan baseline
                    dilakukan di <strong>Sprint Confirmation</strong>.</div>
                </div>
                <button class="btn primary" style="width:100%;margin-top:14px"
                  onclick="navigate('confirmation')">Continue to confirmation →</button>
              </div>
            </div>
          </div>
          <div class="panel" style="margin:16px 0">
            <div class="panelhead">
              <div>
                <h2>Sprint planning timeline</h2>
                <p>Bandingkan draft sprint dengan keseluruhan WBS atau kategori release sebelum dikonfirmasi.</p>
              </div>
            </div>
            <div class="formrow">
              <div class="field">
                <div class="fieldlabel">Gantt view</div><select class="goalinput" id="planningGanttMode"
                  onchange="renderPlanningGantt()">
                  <option value="sprint">Draft sprint tasks</option>
                  <option value="wbs">Whole WBS</option>
                  <option value="label:MVP">MVP</option>
                  <option value="label:Alpha">Alpha</option>
                  <option value="label:Prototype">Prototype</option>
                  <option value="label:Demo">Demo</option>
                  <option value="label:Full release">Full release</option>
                </select>
              </div>
            </div>
            <div id="planningGanttCanvas" class="chart-canvas"></div>
          </div>
          <div class="panel weekly-panel" style="margin-top:16px">
            <div class="panelhead">
              <div>
                <h2>04 · Weekly Target Planning</h2>
                <p>Alokasikan target tiap task per minggu. Setelah dikonfirmasi, tabel ini menjadi rencana mingguan
                  untuk dipantau.</p>
              </div><span class="tag purple">Draft target</span>
            </div>
            <div class="notice" style="margin-bottom:14px"><span>ⓘ</span>
              <div><strong>Target mingguan bukan estimasi effort baru.</strong> Persentase menunjukkan target
                penyelesaian kumulatif task di akhir minggu. Contoh: Week 1 = 40%, Week 2 = 100%.</div>
            </div>
            <div class="tablewrap">
              <table class="table weekly-table">
                <thead>
                  <tr>
                    <th>Division / Owner</th>
                    <th>Task</th>
                    <th>Week 1 target</th>
                    <th>Week 1 notes</th>
                    <th>Week 2 target</th>
                    <th>Week 2 notes</th>
                  </tr>
                </thead>
                <tbody id="weeklyTargetBody"></tbody>
              </table>
            </div>
            <div class="weekly-footer"><span class="muted" id="weeklyTargetSummary">Pilih task dari Product Backlog
                untuk menetapkan target mingguan.</span><button class="btn small"
                onclick="renderWeeklyTargets()">Refresh weekly targets</button></div>
          </div>
        </section>


        <!-- TIMELINE & CHARTS -->
        <section class="section" id="page-charts">
          <div class="pagehead">
            <div>
              <div class="eyebrow">SCHEDULE & DELIVERY INSIGHTS</div>
              <h1>Timeline & Charts</h1>
              <div class="subtitle">Lihat urutan pekerjaan, sisa effort sprint, dan perubahan total scope proyek.</div>
            </div>
            <div class="actions"><button class="btn" onclick="exportChartData()">⇩ Export chart data</button><button
                class="btn primary" onclick="navigate('sprint')">Open sprint planning →</button></div>
          </div>
          <div class="chart-tabs">
            <button class="chart-tab active" data-chart="gantt" onclick="showChart('gantt')">Gantt Chart</button>
            <button class="chart-tab" data-chart="burndown" onclick="showChart('burndown')">Burndown</button>
            <button class="chart-tab" data-chart="burnup" onclick="showChart('burnup')">Burnup</button>
          </div>
          <div id="chart-gantt" class="chart-view">
            <div class="panel" style="margin-bottom:16px">
              <div class="panelhead">
                <div>
                  <h2>Project Gantt Chart</h2>
                  <p>Geser bar secara horizontal untuk mengubah tanggal. Klik bar untuk detail, atau kelola relasi
                    dependency secara terpisah.</p>
                </div>
                <div class="actions"><select class="select" id="ganttFilter" onchange="renderGantt()">
                    <option value="all">All work items</option>
                    <option value="Task">Tasks only</option>
                    <option value="Feature">Features</option>
                    <option value="Epic">Epics</option>
                  </select><button class="btn primary" onclick="toggleDependencyManager()">Manage dependencies</button>
                </div>
              </div>
              <div id="dependencyManager" class="panel" style="display:none;margin-bottom:14px;background:#fbfaff">
                <div class="panelhead">
                  <div>
                    <h2>Dependency editor</h2>
                    <p>Hubungkan predecessor ke successor dan pilih tipe relasi. Lag memakai hari kalender.</p>
                  </div><button class="btn small" onclick="toggleDependencyManager(false)">Close</button>
                </div>
                <div class="formrow">
                  <div class="field">
                    <div class="fieldlabel">Predecessor</div><select class="goalinput" id="depPredecessor"></select>
                  </div>
                  <div class="field">
                    <div class="fieldlabel">Successor</div><select class="goalinput" id="depSuccessor"></select>
                  </div>
                </div>
                <div class="formrow">
                  <div class="field">
                    <div class="fieldlabel">Relationship</div><select class="goalinput" id="depType">
                      <option value="FS">FS · Finish to Start</option>
                      <option value="SS">SS · Start to Start</option>
                      <option value="FF">FF · Finish to Finish</option>
                      <option value="SF">SF · Start to Finish</option>
                    </select>
                  </div>
                  <div class="field">
                    <div class="fieldlabel">Lag / Lead (calendar days)</div><input class="goalinput" id="depLag"
                      type="number" value="0" step="1">
                  </div>
                </div>
                <div class="formactions" style="justify-content:flex-start"><button class="btn primary"
                    onclick="addDependency()">＋ Add dependency</button></div>
                <div class="tablewrap" style="margin-top:12px">
                  <table class="table">
                    <thead>
                      <tr>
                        <th>Predecessor</th>
                        <th>Relationship</th>
                        <th>Successor</th>
                        <th>Lag</th>
                        <th></th>
                      </tr>
                    </thead>
                    <tbody id="dependencyRows"></tbody>
                  </table>
                </div>
                <div class="chart-note">FS: successor mulai setelah predecessor selesai. SS: keduanya mulai
                  bersama/berdasarkan offset. FF: keduanya selesai berdasarkan offset. SF: successor selesai berdasarkan
                  waktu mulai predecessor. Relasi ditampilkan sebagai rencana; jadwal tidak otomatis dipaksa mengikuti
                  dependency agar tidak menggeser item tanpa konfirmasi.</div>
              </div>
              <div class="formrow" style="margin:0 0 10px">
                <div class="field">
                  <div class="fieldlabel">Gantt view</div><select class="goalinput" id="ganttScopeMode"
                    onchange="renderGantt()">
                    <option value="wbs">Whole WBS</option>
                    <option value="label:MVP">MVP</option>
                    <option value="label:Alpha">Alpha</option>
                    <option value="label:Prototype">Prototype</option>
                    <option value="label:Demo">Demo</option>
                    <option value="label:Full release">Full release</option>
                    <option value="sprint">Selected sprint</option>
                  </select>
                </div>
                <div class="field">
                  <div class="fieldlabel">Sprint</div><select class="goalinput" id="ganttSprintSelect"
                    onchange="renderGantt()">
                    <option value="draft">Draft / current planning</option>
                  </select>
                </div>
              </div>
              <div class="chart-canvas" id="ganttCanvas"></div>
              <div class="chart-legend"><span class="legend-item"><i class="legend-swatch"
                    style="background:#6658d3"></i> In progress</span><span class="legend-item"><i class="legend-swatch"
                    style="background:#299764"></i> Completed / on track</span><span class="legend-item"><i
                    class="legend-swatch" style="background:#d9a23d"></i> Not started / review</span><span
                  class="legend-item"><i class="legend-swatch" style="background:#c84d5b"></i> Blocked / at risk</span>
              </div>
              <div class="chart-note">Tanggal dan durasi di bawah adalah data demo untuk eksplorasi UI. Untuk jadwal
                produksi, Gantt perlu memakai tanggal task yang telah disetujui dan kalender kerja aktual.</div>
