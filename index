    }
    let overviewSprintSelection = '';
    function renderOverviewSprintAnalytics() {
      const select = document.getElementById('overviewSprintSelect'), body = document.getElementById('overviewSprintAnalyticsBody');
      if (!select || !body) return;
      const running = confirmedSprints.filter(s => ['In Progress','Completed'].includes(s.status));
      const previous = overviewSprintSelection || select.value;
      select.innerHTML = running.length ? running.map(s => `<option value="${s.id}">${escapeHtml(s.label)} · ${s.status}</option>`).join('') : '<option value="">No running sprint</option>';
      if (!running.length) { overviewSprintSelection=''; body.innerHTML='<div class="empty">Belum ada sprint yang dijalankan. Sprint yang baru dikonfirmasi belum memiliki actual progress.</div>'; return; }
      const chosen = running.find(s => s.id === previous) || running[running.length-1];
      overviewSprintSelection = chosen.id; select.value = chosen.id;
      const reports = dailyReports.filter(r => r.sprintId === chosen.id);
      const tasks = (chosen.tasks || []).filter(t => t && t.id);
      const scope = tasks.reduce((sum,t)=>sum+(Number(t.effort)||0),0);
      const currentProgress = tasks.reduce((sum,t)=>{
        const report = [...reports].filter(r=>r.taskId===t.id).sort((a,b)=>(a.submittedAt||'').localeCompare(b.submittedAt||'')).pop();
        const pct = report ? Number(report.progress)||0 : Number(t.progress)||0;
        return sum+(Number(t.effort)||0)*Math.max(0,Math.min(100,pct))/100;
      },0);
      const completedPct = scope ? currentProgress/scope*100 : 0;
      const remaining = Math.max(0,scope-currentProgress);
      const targetFor = (week) => scope ? tasks.reduce((sum,t)=>sum+(Number(t.effort)||0)*(Number(t['w'+week])||0)/100,0) : 0;
      const targetW1 = targetFor(1), targetW2 = targetFor(2);
      const workdays = Math.max(1,Number(chosen.workingDays)||10), mid = Math.min(5,workdays), end = workdays;
      const points = Array.from({length:workdays+1},(_,day)=>{
        const plannedDone = day<=mid ? (mid ? targetW1*day/mid : 0) : targetW1+(end-mid>0 ? (targetW2-targetW1)*(day-mid)/(end-mid) : 0);
        const idealRemaining = Math.max(0,scope-plannedDone);
        const date = new Date(chosen.start+'T12:00:00'); date.setDate(date.getDate()-1); let added=0;
        while(added<day){date.setDate(date.getDate()+1); if(![0,6].includes(date.getDay())) added++;}
        const key = date.toISOString().slice(0,10);
        const latestByTask = {};
        reports.forEach(r=>{const d=(r.submittedAt||'').slice(0,10); if(d && d<=key && (!latestByTask[r.taskId] || d>=latestByTask[r.taskId].day)) latestByTask[r.taskId]={day:d,progress:Number(r.progress)||0};});
        const actualDone = tasks.reduce((sum,t)=>sum+(Number(t.effort)||0)*(latestByTask[t.id]?.progress||0)/100,0);
        return {day,plannedDone,idealRemaining,actualDone,actualRemaining:Math.max(0,scope-actualDone)};
      });
      const max= Math.max(scope,1), x=i=>42+(i/workdays)*340, y=v=>112-(v/max)*86;
      const poly=key=>points.map((p,i)=>`${i?'L':'M'}${x(i).toFixed(1)},${y(p[key]).toFixed(1)}`).join(' ');
      const chart=(title,subtitle,series,legend)=>`<div class="sprint-analytics-chart"><h3>${title}</h3><p>${subtitle}</p><svg viewBox="0 0 410 145" role="img" aria-label="${title}"><line x1="42" y1="112" x2="382" y2="112" stroke="var(--line)" stroke-width="1"/><line x1="42" y1="20" x2="42" y2="112" stroke="var(--line)" stroke-width="1"/><text x="5" y="24" fill="var(--muted)" font-size="9">${max.toFixed(1)}d</text><text x="18" y="114" fill="var(--muted)" font-size="9">0</text><text x="42" y="130" fill="var(--muted)" font-size="9">Start</text><text x="210" y="130" fill="var(--muted)" font-size="9" text-anchor="middle">Mid sprint</text><text x="382" y="130" fill="var(--muted)" font-size="9" text-anchor="end">End</text>${series.map(s=>`<path d="${poly(s.key)}" fill="none" stroke="${s.color}" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" ${s.dash?'stroke-dasharray="5 4"':''}/>`).join('')}</svg><div class="analytics-legend">${legend.map(l=>`<span><i style="--legend-color:${l.color}"></i>${l.label}</span>`).join('')}</div></div>`;
      const actualRemaining = remaining, weeklyActual = scope ? currentProgress/scope*100 : 0, week1Actual = points[Math.min(5,points.length-1)]?.actualDone || 0;
      body.innerHTML = `<div class="sprint-analytics-kpis"><div class="sprint-analytics-kpi"><small>Initial scope</small><strong>${scope.toFixed(1)} d</strong></div><div class="sprint-analytics-kpi"><small>Completed work</small><strong>${currentProgress.toFixed(1)} d</strong></div><div class="sprint-analytics-kpi"><small>Remaining work</small><strong>${actualRemaining.toFixed(1)} d</strong></div><div class="sprint-analytics-kpi"><small>Progress</small><strong>${weeklyActual.toFixed(1)}%</strong></div></div><div class="sprint-analytics-charts">${chart('Burndown','Remaining effort · person-days',[{key:'idealRemaining',color:'#8b879f',dash:true},{key:'actualRemaining',color:'#6658d3'}],[{label:'Ideal remaining',color:'#8b879f'},{label:'Actual remaining',color:'#6658d3'}])}${chart('Burnup','Completed effort · person-days',[{key:'plannedDone',color:'#8b879f',dash:true},{key:'actualDone',color:'#16a085'}],[{label:'Planned completed',color:'#8b879f'},{label:'Actual completed',color:'#16a085'},{label:'Initial scope',color:'#d49a36'}])}</div><table class="weekly-checkpoint-table"><thead><tr><th>Checkpoint</th><th>Planned</th><th>Actual</th><th>Variance</th></tr></thead><tbody><tr><td>Week 1</td><td>${targetW1.toFixed(1)} d (${scope?(targetW1/scope*100).toFixed(1):0}%)</td><td>${week1Actual.toFixed(1)} d</td><td>${(week1Actual-targetW1>=0?'+':'')+(week1Actual-targetW1).toFixed(1)} d</td></tr><tr><td>Week 2 / End</td><td>${targetW2.toFixed(1)} d (${scope?(targetW2/scope*100).toFixed(1):0}%)</td><td>${currentProgress.toFixed(1)} d</td><td>${(currentProgress-targetW2>=0?'+':'')+(currentProgress-targetW2).toFixed(1)} d</td></tr></tbody></table><p class="chart-note" style="margin-top:10px">Actual dihitung dari progress terakhir setiap task yang dikirim melalui Daily Report, dibobot berdasarkan effort baseline. Planned menggunakan Weekly Target. Total scope adalah baseline saat sprint dikonfirmasi.</p>`;
      const burnupSvg = body.querySelector('.sprint-analytics-chart:nth-child(2) svg');
      if (burnupSvg) { const line=document.createElementNS('http://www.w3.org/2000/svg','path'); line.setAttribute('d',`M42,${y(scope)} L382,${y(scope)}`); line.setAttribute('stroke','#d49a36'); line.setAttribute('stroke-width','2'); line.setAttribute('stroke-dasharray','4 4'); line.setAttribute('fill','none'); burnupSvg.appendChild(line); }
