      const totalEffort = leafItems.reduce((sum,x)=>sum+(Number(x.effort)||0),0);
      if (!leafItems.length || totalEffort <= 0) {
        body.innerHTML = `<div class="empty">Belum ada leaf task dengan milestone ${escapeHtml(milestone)}. Atur milestone pada work item di WBS.</div>`;
        return;
      }
      const completedEffort = leafItems.reduce((sum,x)=>sum+(Number(x.effort)||0)*Math.max(0,Math.min(100,Number(x.progress)||0))/100,0);
      const pct = Math.round(completedEffort/totalEffort*100);
