      const root = document.getElementById('planningGanttCanvas'); if (!root) return;
      const mode = document.getElementById('planningGanttMode')?.value || 'sprint'; const ids = mode === 'sprint' ? new Set(selectedTasks().map(x => x.id)) : mode === 'wbs' ? new Set(items.map(x => x.id)) : new Set(labelItems(mode.slice(6)).map(x => x.id)); const rows = items.filter(x => ids.has(x.id)).slice(0, 12);
      if (!rows.length) {root.innerHTML = '<div class="empty">Pilih task di Product Backlog untuk melihat Gantt draft sprint.</div>'; return;}
      const min = Math.min(...rows.map(x => new Date(x.startDate + 'T00:00:00').getTime())), max = Math.max(...rows.map(x => new Date(x.endDate + 'T00:00:00').getTime())) || min + 86400000, day = 86400000, days = Math.max(1, Math.round((max - min) / day)), labelW = 210, plotW = Math.max(480, days * 18), rowH = 30, height = 32 + rows.length * rowH;
      let svg = `<svg viewBox="0 0 ${labelW + plotW + 10} ${height}" style="min-width:700px;width:100%">`; for (let d = 0; d <= days; d++) {const xx = labelW + d * plotW / days; svg += `<line x1="${xx}" y1="30" x2="${xx}" y2="${height}" stroke="#e8ebf2"/>`; if (d % Math.max(1, Math.ceil(days / 8)) === 0) {const dt = new Date(min + d * day); svg += `<text x="${xx + 3}" y="18" font-size="10" fill="#7b8499">${dt.getDate()} ${dt.toLocaleString('en', {month: 'short'})}</text>`} } rows.forEach((x, i) => {const y = 32 + i * rowH, bx = labelW + (new Date(x.startDate + 'T00:00:00').getTime() - min) / day * plotW / days, bw = Math.max(8, ((new Date(x.endDate + 'T00:00:00').getTime() - new Date(x.startDate + 'T00:00:00').getTime()) / day + 1) * plotW / days); svg += `<text x="6" y="${y + 17}" font-size="10" fill="#48516a">${escapeHtml(x.name.slice(0, 27))}</text><rect x="${bx}" y="${y + 6}" width="${Math.min(bw, plotW)}" height="16" rx="4" fill="${x.progress >= 100 ? '#299764' : '#6658d3'}"/><rect x="${bx}" y="${y + 6}" width="${Math.min(bw, plotW) * x.progress / 100}" height="16" rx="4" fill="#20283a" opacity=".16"/></svg>`}); svg += '</svg>'; root.innerHTML = svg;
    }

    function traceFunction(name, fn) {
