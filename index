<!DOCTYPE html>
<html lang="id">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ForgePM · Game Project Workspace</title>
  <style>
    :root {
      --bg: #f5f7fb;
      --panel: #fff;
      --text: #20283a;
      --muted: #778197;
      --line: #e7ebf2;
      --primary: #6658d3;
      --primary2: #f0edff;
      --teal: #1e9b8a;
      --tealbg: #e7f7f3;
      --amber: #b7791f;
      --amberbg: #fff4d9;
      --red: #c84d5b;
      --redbg: #fff0f1;
      --blue: #3b78c7;
      --bluebg: #eaf3ff;
      --green: #27845f;
      --greenbg: #e8f7ef;
      --shadow: 0 8px 28px rgba(31, 42, 68, .06);
      --radius: 16px;
    }

    * {
      box-sizing: border-box
    }

    body {
      margin: 0;
      background: var(--bg);
      color: var(--text);
      font: 14px/1.45 Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif
    }

    button,
    input,
    select,
    textarea {
      font: inherit
    }

    button {
      cursor: pointer
    }

    .app {
      display: grid;
      grid-template-columns: 244px minmax(0, 1fr);
      min-height: 100vh
    }

    .sidebar {
      background: #171d31;
      color: #d8deef;
      padding: 22px 14px;
      display: flex;
      flex-direction: column;
      gap: 24px
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 0 9px;
      font-weight: 800;
      font-size: 18px;
      letter-spacing: -.5px;
      color: #fff
    }

    .brandmark {
      width: 34px;
      height: 34px;
      border-radius: 11px;
      background: linear-gradient(135deg, #8e83ff, #5e52c7);
      display: grid;
      place-items: center;
      font-weight: 900;
      color: #fff
    }

    .project-switch {
      background: #252c43;
      border: 1px solid #343c56;
      border-radius: 12px;
      padding: 12px;
      color: #fff;
      display: flex;
      justify-content: space-between;
      align-items: center;
      text-align: left
    }

    .project-switch small {
      display: block;
      color: #9ba7c2;
      font-size: 11px;
      margin-bottom: 2px
    }

    .navgroup {
      display: flex;
      flex-direction: column;
      gap: 4px
    }

    .navtitle {
      font-size: 10px;
      text-transform: uppercase;
      letter-spacing: 1.2px;
      color: #7e8aa8;
      padding: 0 12px 7px;
      font-weight: 800
    }

    .navitem {
      border: 0;
      background: transparent;
      color: #aeb8d0;
      border-radius: 10px;
      padding: 10px 12px;
      display: flex;
      gap: 11px;
      align-items: center;
      text-align: left;
      width: 100%;
      transition: .15s
    }

    .navitem:hover {
      background: #252c43;
      color: #fff
    }

    .navitem.active {
      background: #39345f;
      color: #fff;
      font-weight: 700
    }

    .navicon {
      width: 19px;
      text-align: center;
      font-size: 15px
    }

    .sidebar-bottom {
      margin-top: auto;
      border-top: 1px solid #303750;
      padding: 16px 10px 0;
      color: #8f9bb6;
      font-size: 12px
    }

    .main {
      min-width: 0
    }

    .topbar {
      height: 72px;
      background: rgba(255, 255, 255, .92);
      border-bottom: 1px solid var(--line);
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 32px;
      gap: 16px;
      position: sticky;
      top: 0;
      z-index: 10;
      backdrop-filter: blur(10px)
    }

    .crumb {
      font-size: 12px;
      color: var(--muted)
    }

    .crumb strong {
      color: var(--text)
    }

    .top-actions {
      display: flex;
      align-items: center;
      gap: 10px
    }

    .avatar {
      width: 34px;
      height: 34px;
      background: #f1d9c8;
      color: #68412b;
      border-radius: 50%;
      display: grid;
      place-items: center;
      font-weight: 800
    }

    .content {
      max-width: 1500px;
      margin: 0 auto;
      padding: 28px 32px 48px
    }

    .pagehead {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: 18px;
      margin-bottom: 24px
    }

    .eyebrow {
      color: var(--primary);
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 1.3px;
      font-size: 10px;
      margin-bottom: 7px
    }

    h1 {
      font-size: 27px;
      line-height: 1.2;
      margin: 0 0 7px;
      letter-spacing: -.8px
    }

    h2 {
      font-size: 17px;
      margin: 0;
      letter-spacing: -.3px
    }

    h3 {
      font-size: 14px;
      margin: 0
    }

    .subtitle {
      color: var(--muted);
      max-width: 740px
    }

    .actions {
      display: flex;
      gap: 8px;
      flex-wrap: wrap
    }

    .btn {
      border: 1px solid var(--line);
      background: #fff;
      color: var(--text);
      border-radius: 10px;
      padding: 9px 13px;
      font-weight: 650;
      display: inline-flex;
      align-items: center;
      gap: 7px;
      justify-content: center
    }

    .btn:hover {
      border-color: #c7cce0;
      background: #fafbff
    }

    .btn.primary {
      background: var(--primary);
      border-color: var(--primary);
      color: #fff
    }

    .btn.primary:hover {
      background: #5548c0
    }

    .btn.ghost {
      border-color: transparent;
      background: transparent
    }

    .btn.small {
      padding: 6px 9px;
      font-size: 12px;
      border-radius: 8px
    }

    .btn:disabled {
      opacity: .45;
      cursor: not-allowed
    }

    .grid {
      display: grid;
      gap: 16px
    }

    .stats {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      margin-bottom: 18px
    }

    .stat,
    .panel,
    .card {
      background: var(--panel);
      border: 1px solid var(--line);
      border-radius: var(--radius);
      box-shadow: var(--shadow)
    }

    .stat {
      padding: 17px 18px
    }

    .statlabel {
      font-size: 12px;
      color: var(--muted);
      display: flex;
      justify-content: space-between;
      gap: 8px
    }

    .statvalue {
      font-size: 27px;
      font-weight: 800;
      letter-spacing: -.8px;
      margin: 8px 0 4px
    }

    .statfoot {
      font-size: 11px;
      color: var(--muted)
    }

    .statfoot strong {
      color: var(--green)
    }

    .two-col {
      grid-template-columns: minmax(0, 1.4fr) minmax(310px, .9fr)
    }

    .panel {
      padding: 20px;
      min-width: 0
    }

    .panelhead {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      margin-bottom: 17px
    }

    .panelhead p {
      color: var(--muted);
      font-size: 12px;
      margin: 4px 0 0
    }

    .linkbtn {
      background: none;
      border: 0;
      color: var(--primary);
      font-weight: 750;
      font-size: 12px
    }

    .progressrow {
      display: flex;
      justify-content: space-between;
      gap: 12px;
      font-size: 12px;
      margin: 14px 0 7px
    }

    .bar {
      height: 8px;
      border-radius: 99px;
      background: #edf0f6;
      overflow: hidden
    }

    .fill {
      height: 100%;
      border-radius: 99px;
      background: var(--primary)
    }

    .fill.teal {
      background: var(--teal)
    }

    .fill.amber {
      background: #e4a53e
    }

    .fill.red {
      background: var(--red)
    }

    .tag {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      border-radius: 7px;
      padding: 4px 8px;
      font-size: 11px;
      font-weight: 750;
      white-space: nowrap
    }

    .tag.purple {
      background: var(--primary2);
      color: var(--primary)
    }

    .tag.green {
      background: var(--greenbg);
      color: var(--green)
    }

    .tag.amber {
      background: var(--amberbg);
      color: var(--amber)
    }

    .tag.red {
      background: var(--redbg);
      color: var(--red)
    }

    .tag.blue {
      background: var(--bluebg);
      color: var(--blue)
    }

    .tag.gray {
      background: #f0f2f7;
      color: #67728a
    }

    .list {
      display: flex;
      flex-direction: column
    }

    .listrow {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 13px 0;
      border-bottom: 1px solid var(--line)
    }

    .listrow:last-child {
      border-bottom: 0
    }

    .dot {
      width: 9px;
      height: 9px;
      border-radius: 50%;
      background: var(--primary);
      flex-shrink: 0
    }

    .rowmain {
      flex: 1;
      min-width: 0
    }

    .rowmain strong {
      display: block;
      font-size: 13px
    }

    .rowmain small {
      color: var(--muted);
      font-size: 11px
    }

    .rowend {
      display: flex;
      align-items: center;
      gap: 9px
    }

    .section {
      display: none
    }

    .section.active {
      display: block
    }

    .toolbar {
      display: flex;
      gap: 10px;
      align-items: center;
      flex-wrap: wrap;
      margin-bottom: 15px
    }

    .search {
      min-width: 210px;
      flex: 1;
      position: relative
    }

    .search input {
      width: 100%;
      padding: 10px 12px 10px 35px;
      border: 1px solid var(--line);
      border-radius: 10px;
      background: #fff;
      outline: none
    }

    .search span {
      position: absolute;
      left: 12px;
      top: 9px;
      color: var(--muted)
    }

    .select {
      border: 1px solid var(--line);
      border-radius: 10px;
      background: #fff;
      padding: 10px 12px;
      color: #46516a;
      outline: none
    }

    .tablewrap {
      overflow: auto;
      border: 1px solid var(--line);
      border-radius: 13px;
      background: #fff
    }

    .table {
      border-collapse: collapse;
      width: 100%;
      min-width: 760px
    }

    .table th {
      text-align: left;
      background: #fafbfe;
      color: #7b8498;
      text-transform: uppercase;
      letter-spacing: .7px;
      font-size: 10px;
      padding: 12px 14px;
      border-bottom: 1px solid var(--line);
      white-space: nowrap
    }

    .table td {
      padding: 13px 14px;
      border-bottom: 1px solid #eff1f6;
      font-size: 12px;
      vertical-align: middle
    }

    .table tr:last-child td {
      border-bottom: 0
    }

    .table tbody tr:hover {
      background: #fbfbff
    }

    .namecell {
      display: flex;
      align-items: center;
      gap: 8px;
      font-weight: 700;
      white-space: nowrap
    }

    .indent {
      display: inline-block;
      width: 14px;
      flex-shrink: 0
    }

    .twisty {
      border: 0;
      background: transparent;
      color: #8590a6;
      padding: 0;
      width: 17px
    }

    .typeicon {
      width: 25px;
      height: 25px;
      border-radius: 7px;
      background: #f0edff;
      color: var(--primary);
      display: grid;
      place-items: center;
      font-size: 11px;
      font-weight: 900
    }

    .typeicon.epic {
      background: #eaf3ff;
      color: #3b78c7
    }

    .typeicon.feature {
      background: #e7f7f3;
      color: #1e9b8a
    }

    .typeicon.task {
      background: #f0f2f7;
      color: #6d778c
    }

    .tablefoot {
      display: flex;
      justify-content: space-between;
      padding: 12px 2px;
      color: var(--muted);
      font-size: 11px
    }

    .taskcard {
      display: flex;
      align-items: flex-start;
      gap: 10px;
      padding: 13px;
      border: 1px solid var(--line);
      border-radius: 12px;
      background: #fff
    }

    .taskcard+.taskcard {
      margin-top: 9px
    }

    .taskcheck {
      width: 17px;
      height: 17px;
      border: 1.5px solid #cbd1df;
      border-radius: 5px;
      margin-top: 2px;
      flex-shrink: 0
    }

    .taskinfo {
      flex: 1;
      min-width: 0
    }

    .taskinfo strong {
      display: block;
      font-size: 13px
    }

    .taskinfo small {
      display: block;
      color: var(--muted);
      font-size: 11px;
      margin-top: 3px
    }

    .taskmeta {
      display: flex;
      gap: 7px;
      align-items: center;
      flex-wrap: wrap;
      margin-top: 9px
    }

    .taskmeta .tag {
      font-size: 10px
    }

    .planner-grid {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(300px, .85fr);
      gap: 16px;
      align-items: start
    }

    .sprintbox {
      border: 1px solid var(--line);
      border-radius: 13px;
      padding: 16px;
      background: #fff
    }

    .sprintbox+.sprintbox {
      margin-top: 12px
    }

    .capacity {
      padding: 15px;
      border-radius: 12px;
      background: #f8f7ff;
      border: 1px solid #e8e4ff;
      margin-bottom: 15px
    }

    .capacitytop {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 10px
    }

    .capacitynum {
      font-size: 21px;
      font-weight: 800
    }

    .capacity small {
      color: var(--muted)
    }

    .draftlist {
      min-height: 80px;
      margin: 12px 0
    }

    .empty {
      border: 1px dashed #d9deea;
      border-radius: 10px;
      padding: 22px;
      text-align: center;
      color: var(--muted);
      font-size: 12px
    }

    .goalinput {
      width: 100%;
      border: 1px solid var(--line);
      border-radius: 10px;
      padding: 11px 12px;
      outline: none;
      margin-top: 7px
    }

    .fieldlabel {
      font-size: 11px;
      color: #6f7a90;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: .6px
    }

    .field {
      margin-bottom: 16px
    }

    .field textarea {
      resize: vertical;
      min-height: 74px
    }

    .formrow {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px
    }

    .timeline {
      position: relative;
      padding-left: 23px
    }

    .timeline:before {
      content: "";
      position: absolute;
      left: 7px;
      top: 8px;
      bottom: 8px;
      width: 2px;
      background: #e7eaf2
    }

    .event {
      position: relative;
      padding: 0 0 23px
    }

    .event:before {
      content: "";
      position: absolute;
      left: -21px;
      top: 4px;
      width: 10px;
      height: 10px;
      border: 3px solid #fff;
      box-shadow: 0 0 0 1px #d8dcef;
      border-radius: 50%;
      background: var(--primary)
    }

    .event small {
      color: var(--muted);
      font-size: 11px
    }

    .event strong {
      display: block;
      margin: 4px 0;
      font-size: 13px
    }

    .buildcard {
      padding: 18px;
      border: 1px solid var(--line);
      border-radius: 14px;
      background: #fff
    }

    .buildcard+.buildcard {
      margin-top: 12px
    }

    .buildhead {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: 10px
    }

    .buildhead h3 {
      font-size: 15px
    }

    .builddate {
      font-size: 11px;
      color: var(--muted);
      margin-top: 4px
    }

    .buildmetrics {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 10px;
      margin-top: 17px
    }

    .metric {
      background: #f8f9fc;
      border-radius: 9px;
      padding: 10px
    }

    .metric small {
      display: block;
      color: var(--muted);
      font-size: 10px
    }

    .metric strong {
      display: block;
      font-size: 16px;
      margin-top: 4px
    }

    .notice {
      display: flex;
      gap: 10px;
      padding: 13px;
      border-radius: 12px;
      background: var(--amberbg);
      color: #805619;
      font-size: 12px;
      line-height: 1.5;
      margin-bottom: 16px
    }

    .notice strong {
      display: block
    }

    .modalback {
      position: fixed;
      inset: 0;
      background: rgba(21, 27, 46, .42);
      display: none;
      align-items: center;
      justify-content: center;
      padding: 20px;
      z-index: 30
    }

    .modalback.show {
      display: flex
    }

    .modal {
      background: #fff;
      width: min(560px, 100%);
      border-radius: 18px;
      box-shadow: 0 24px 70px rgba(10, 15, 30, .25);
      padding: 24px;
      max-height: 90vh;
      overflow: auto
    }

    .modalhead {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 20px
    }

    .close {
      border: 0;
      background: #f1f3f8;
      border-radius: 8px;
      width: 30px;
      height: 30px
    }

    .formactions {
      display: flex;
      justify-content: flex-end;
      gap: 8px;
      margin-top: 20px
    }

    .toast {
      position: fixed;
      right: 24px;
      bottom: 24px;
      background: #20283a;
      color: #fff;
      border-radius: 12px;
      padding: 13px 17px;
      box-shadow: var(--shadow);
      display: none;
      z-index: 50;
      font-size: 13px
    }

    .toast.show {
      display: block;
      animation: fade .25s
    }

    @keyframes fade {
      from {
        transform: translateY(8px);
        opacity: 0
      }

      to {
        transform: translateY(0);
        opacity: 1
      }
    }

    .mobilemenu {
      display: none
    }

    .muted {
      color: var(--muted)
    }

    .nowrap {
      white-space: nowrap
    }

    .emptyline {
      padding: 24px;
      text-align: center;
      color: var(--muted)
    }

    @media(max-width:1100px) {
      .stats {
        grid-template-columns: repeat(2, 1fr)
      }

      .two-col,
      .planner-grid {
        grid-template-columns: 1fr
      }

      .content {
        padding: 24px 20px
      }

      .topbar {
        padding: 0 20px
      }
    }

    @media(max-width:720px) {
      .app {
        grid-template-columns: 1fr
      }

      .sidebar {
        display: none;
        position: fixed;
        z-index: 20;
        inset: 0 auto 0 0;
        width: 250px
      }

      .sidebar.open {
        display: flex
      }

      .mobilemenu {
        display: inline-flex
      }

      .topbar {
        height: 62px;
        padding: 0 14px
      }

      .content {
        padding: 20px 13px 36px
      }

      .pagehead {
        display: block
      }

      .pagehead .actions {
        margin-top: 16px
      }

      .stats {
        grid-template-columns: 1fr 1fr;
        gap: 10px
      }

      .stat {
        padding: 13px
      }

      .statvalue {
        font-size: 23px
      }

      .statlabel {
        font-size: 11px
      }

      .formrow {
        grid-template-columns: 1fr
      }

      .panel {
        padding: 15px
      }

      .buildmetrics {
        grid-template-columns: 1fr 1fr 1fr
      }

      .crumb {
        display: none
      }
    }

    .chart-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 16px
    }

    .chart-panel {
      background: #fff;
      border: 1px solid var(--line);
      border-radius: 16px;
      padding: 18px;
      box-shadow: var(--shadow);
      min-width: 0
    }

    .chart-canvas {
      width: 100%;
      overflow: auto
    }

    .chart-canvas svg {
      display: block;
      width: 100%;
      height: auto;
      min-width: 520px
    }

    .chart-legend {
      display: flex;
      gap: 14px;
      flex-wrap: wrap;
      font-size: 11px;
      color: var(--muted);
      margin-top: 12px
    }

    .legend-item {
      display: flex;
      align-items: center;
      gap: 6px
    }

    .legend-swatch {
      width: 9px;
      height: 9px;
      border-radius: 3px;
      display: inline-block
    }

    .chart-tabs {
      display: flex;
      gap: 6px;
      flex-wrap: wrap;
      margin-bottom: 15px
    }

    .chart-tab {
      border: 1px solid var(--line);
      background: #fff;
      color: var(--muted);
      padding: 8px 12px;
      border-radius: 9px;
      font-size: 12px;
      font-weight: 700
    }

    .chart-tab.active {
      background: var(--primary2);
      color: var(--primary);
      border-color: #d8d1ff
    }

    .chart-note {
      font-size: 11px;
      color: var(--muted);
      margin-top: 10px;
      line-height: 1.5
    }

    .clickable-row {
      cursor: pointer
    }

    .clickable-row:hover td {
      background: #f6f5ff !important
    }

    .item-open {
      border: 0;
      background: transparent;
      padding: 0;
      color: inherit;
      text-align: left;
      font-weight: 750
    }

    .item-open:hover {
      color: var(--primary);
      text-decoration: underline
    }

    .gantt-label {
      font-size: 11px;
      fill: #4e5870
    }

    .gantt-grid {
      stroke: #e9edf4;
      stroke-width: 1
    }

